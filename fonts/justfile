
default:
    @just --list

update-maple-mono:
    wget --quiet --show-progress 'https://github.com/subframe7536/maple-font/releases/latest/download/MapleMono-NF.zip'
    unzip -o \
        -d 'MapleMono-NF' 'MapleMono-NF.zip' \
        'MapleMono-NF-Bold.ttf' 'MapleMono-NF-BoldItalic.ttf' 'MapleMono-NF-Italic.ttf' 'MapleMono-NF-Regular.ttf'
    rm 'MapleMono-NF.zip'
    cp MapleMono-NF/*.ttf ~/Library/Fonts/

IOSEVKA_RELEASE_VERSION := ```
    gh release list \
        --repo 'be5invis/Iosevka' \
        --json 'isLatest,tagName' \
        --jq '.[] | select(.isLatest == true) | .tagName' \
        | cut -d'v' -f2
```
NERD_FONTS_RELEASE_VERSION := ```
    gh release list \
        --repo 'ryanoasis/nerd-fonts' \
        --json 'isLatest,tagName' \
        --jq '.[] | select(.isLatest == true) | .tagName' \
        | cut -d'v' -f2
```
update-iosevka:
    echo "{{IOSEVKA_RELEASE_VERSION}}"
    echo "{{NERD_FONTS_RELEASE_VERSION}}"
    wget --quiet --show-progress \
        'https://github.com/be5invis/Iosevka/releases/download/v{{IOSEVKA_RELEASE_VERSION}}/PkgTTF-Unhinted-Iosevka-{{IOSEVKA_RELEASE_VERSION}}.zip' \
        'https://github.com/be5invis/Iosevka/releases/download/v{{IOSEVKA_RELEASE_VERSION}}/PkgTTF-Unhinted-IosevkaAile-{{IOSEVKA_RELEASE_VERSION}}.zip' \
        'https://github.com/be5invis/Iosevka/releases/download/v{{IOSEVKA_RELEASE_VERSION}}/PkgTTF-Unhinted-IosevkaEtoile-{{IOSEVKA_RELEASE_VERSION}}.zip' \
        'https://github.com/be5invis/Iosevka/releases/download/v{{IOSEVKA_RELEASE_VERSION}}/PkgTTF-Unhinted-IosevkaTerm-{{IOSEVKA_RELEASE_VERSION}}.zip'
    unzip -o \
        -d 'Iosevka' 'PkgTTF-Unhinted-Iosevka-{{IOSEVKA_RELEASE_VERSION}}.zip' \
        'Iosevka-Bold.ttf' 'Iosevka-BoldItalic.ttf' 'Iosevka-Italic.ttf' 'Iosevka-Regular.ttf'
    unzip -o \
        -d 'Iosevka' 'PkgTTF-Unhinted-IosevkaAile-{{IOSEVKA_RELEASE_VERSION}}.zip' \
        'IosevkaAile-Bold.ttf' 'IosevkaAile-BoldItalic.ttf' 'IosevkaAile-Italic.ttf' 'IosevkaAile-Regular.ttf'
    unzip -o \
        -d 'Iosevka' 'PkgTTF-Unhinted-IosevkaEtoile-{{IOSEVKA_RELEASE_VERSION}}.zip' \
        'IosevkaEtoile-Bold.ttf' 'IosevkaEtoile-BoldItalic.ttf' 'IosevkaEtoile-Italic.ttf' 'IosevkaEtoile-Regular.ttf'
    unzip -o \
        -d 'Iosevka' 'PkgTTF-Unhinted-IosevkaTerm-{{IOSEVKA_RELEASE_VERSION}}.zip' \
        'IosevkaTerm-Bold.ttf' 'IosevkaTerm-BoldItalic.ttf' 'IosevkaTerm-Italic.ttf' 'IosevkaTerm-Regular.ttf'
    wget --quiet --show-progress \
        'https://github.com/ryanoasis/nerd-fonts/raw/v{{NERD_FONTS_RELEASE_VERSION}}/patched-fonts/IosevkaTerm/IosevkaTermNerdFontMono-Bold.ttf' \
        'https://github.com/ryanoasis/nerd-fonts/raw/v{{NERD_FONTS_RELEASE_VERSION}}/patched-fonts/IosevkaTerm/IosevkaTermNerdFontMono-BoldItalic.ttf' \
        'https://github.com/ryanoasis/nerd-fonts/raw/v{{NERD_FONTS_RELEASE_VERSION}}/patched-fonts/IosevkaTerm/IosevkaTermNerdFontMono-Italic.ttf' \
        'https://github.com/ryanoasis/nerd-fonts/raw/v{{NERD_FONTS_RELEASE_VERSION}}/patched-fonts/IosevkaTerm/IosevkaTermNerdFontMono-Regular.ttf'
    mv -f \
        IosevkaTermNerdFontMono-Bold.ttf \
        IosevkaTermNerdFontMono-BoldItalic.ttf \
        IosevkaTermNerdFontMono-Italic.ttf \
        IosevkaTermNerdFontMono-Regular.ttf \
        Iosevka/
    rm -rf *.zip
    cp Iosevka/*.ttf ~/Library/Fonts/

SARASA_RELEASE_VERSION := ```
    gh release list \
        --repo 'be5invis/Sarasa-Gothic' \
        --json 'isLatest,tagName' \
        --jq '.[] | select(.isLatest == true) | .tagName' \
        | cut -d'v' -f2
```
update-sarasa:
    echo "{{SARASA_RELEASE_VERSION}}"
    wget --quiet --show-progress \
        'https://github.com/be5invis/Sarasa-Gothic/releases/download/v{{SARASA_RELEASE_VERSION}}/SarasaMono-TTF-Unhinted-{{SARASA_RELEASE_VERSION}}.7z' \
        'https://github.com/be5invis/Sarasa-Gothic/releases/download/v{{SARASA_RELEASE_VERSION}}/SarasaTerm-TTF-Unhinted-{{SARASA_RELEASE_VERSION}}.7z'
    7z e 'SarasaMono-TTF-Unhinted-{{SARASA_RELEASE_VERSION}}.7z' -o'SarasaMono' 'SarasaMonoJ-Bold.ttf' 'SarasaMonoJ-BoldItalic.ttf' 'SarasaMonoJ-Italic.ttf' 'SarasaMonoJ-Regular.ttf'
    7z e 'SarasaTerm-TTF-Unhinted-{{SARASA_RELEASE_VERSION}}.7z' -o'SarasaTerm' 'SarasaTermJ-Bold.ttf' 'SarasaTermJ-BoldItalic.ttf' 'SarasaTermJ-Italic.ttf' 'SarasaTermJ-Regular.ttf'
    rm -rf *.7z
    cp SarasaMono/*.ttf SarasaTerm/*.ttf ~/Library/Fonts/
